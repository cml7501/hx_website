---
import { site } from '../lib/site.js';

interface Props {
  lang: 'zh' | 'en';
  title: string;
  desc: string;
  kw?: string;
  /** 当前页不含语言前缀的规范路径，如 '/about/'、'/products/hx-21/' */
  path: string;
}

const { lang, title, desc, kw, path } = Astro.props;
const zhUrl = site.company.website.replace(/\/$/, '') + path;
const enUrl = site.company.website.replace(/\/$/, '') + (lang === 'en' ? path : '/en' + path);
const canonical = lang === 'en' ? enUrl : zhUrl;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={desc} />
{kw && <meta name="keywords" content={kw} />}
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="zh-CN" href={zhUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="x-default" href={zhUrl} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={site.company.name[lang]} />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="shortcut icon" href="/favicon.ico" />

<!-- ============ 全站配置点 ============
     HX_BAIDU_TONGJI_ID：百度统计站点 ID，留空则不启用（上线时填入）
     HX_FORM_ENDPOINT：询价表单提交接口，留空为演示模式（前端校验后提示成功）；
     已配置为跟随页面访问地址的管理服务接口（4173 端口）：本机浏览自动用 127.0.0.1，
     局域网其他设备浏览自动用服务器 IP，无需按设备分别修改 -->
<script is:inline>
  window.HX_BAIDU_TONGJI_ID = '';
  window.HX_FORM_ENDPOINT = location.hostname ? 'http://' + location.hostname + ':4173/api/inquiry' : '';
</script>

{/** 百度统计：仅在配置了站点 ID 时加载 */}
<script is:inline>
  (function () {
    var id = window.HX_BAIDU_TONGJI_ID;
    if (!id) return;
    var hm = document.createElement('script');
    hm.src = 'https://hm.baidu.com/hm.js?' + id;
    document.head.appendChild(hm);
  })();
</script>
